.DS_Store
**/.DS_Store

# Local JetBrains project files
.idea/compiler.xml
.idea/encodings.xml
.idea/vcs.xml

terraform/**/tfplan

helm/**/charts/*.tgz
# Chart.lock adds no version-pinning value for our file://../common deps
# (digest is over Chart.yaml's deps, not common's content). It's regenerated
# at deploy time by `helm dependency build` on Helm 4. Keep it out of git.
helm/**/Chart.lock

**/target/
